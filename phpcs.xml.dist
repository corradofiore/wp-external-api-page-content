<?xml version="1.0"?>
<ruleset name="HiveKit External API Page Content">
	<description>Coding standards for the HiveKit External API Page Content plugin.</description>

	<file>.</file>

	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="basepath" value="."/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="hivekit-external-api-page-content"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="hivekit_eapc,HIVEKIT_EAPC,HiveKit_EAPC"/>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.8"/>
	<config name="testVersion" value="8.3-"/>
</ruleset>
